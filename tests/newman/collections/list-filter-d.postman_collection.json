{
  "info": {
    "_postman_id": "4e6be3c5-b2ba-4ff6-8b32-15bf4a9734ea",
    "name": "kacho-vpc / newman / list-filter-d",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId') || pm.environment.get('runId') === '') {",
          "  // runId формат: только [a-z0-9], без точки — чтобы проходить name regex.",
          "  const t = Date.now().toString(36);",
          "  const r = Math.floor(Math.random() * 1e9).toString(36);",
          "  pm.environment.set('runId', (t + r).replace(/[^a-z0-9]/g, '').slice(-10));",
          "}",
          "pm.environment.set('_suiteProjectId', pm.environment.get('existingProjectId'));",
          "pm.environment.set('_suiteProjectCrossId', pm.environment.get('existingProjectCrossId'));",
          "// Default auth: projectAdmin on project A1 — sufficient for most happy-path steps.",
          "// Per-step auth= overrides this via item-level pre-request script (_auth_pre_script).",
          "const __defaultJwt = pm.environment.get('jwtProjectAdminA1') || pm.variables.get('jwtProjectAdminA1') || '';",
          "if (__defaultJwt && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __defaultJwt});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "SUBNET-LF-D-VISIBLE — per-object List: subject sees the subnet it was granted (D-40/D-41/D-43)",
      "description": "class:AUTHZ | class:CONF | priority:P0",
      "item": [
        {
          "name": "List subnets as subset-viewer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vpc/v1/subnets?projectId={{listFilterProjectId}}&pageSize=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vpc",
                "v1",
                "subnets?projectId={{listFilterProjectId}}&pageSize=1000"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// authz-deny: bearer from env 'jwtSubnetSubsetViewer'",
                  "const __t = pm.environment.get('jwtSubnetSubsetViewer') || pm.variables.get('jwtSubnetSubsetViewer') || '';",
                  "if (__t) {",
                  "  pm.request.headers.upsert({key: 'Authorization', value: 'Bearer ' + __t});",
                  "} else {",
                  "  pm.request.headers.remove('Authorization');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SUBNET-LF-D-VISIBLE] status 200', () => pm.expect(pm.response.code).to.eql(200));",
                  "const j = pm.response.json();",
                  "const ids = (j.subnets || []).map(s => s.id);",
                  "pm.test('[SUBNET-LF-D-VISIBLE] granted subnet present', () => pm.expect(ids, JSON.stringify(ids)).to.include(pm.environment.get('subnetVisibleId')));"
                ]
              }
            }
          ]
        }
      ]
    },
